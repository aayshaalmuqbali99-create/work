# PostgreSQL connection string
DATABASE_URL="postgresql://labsouq:labsouq_dev@localhost:5432/labsouq?schema=public"

# Public address of the website (no trailing slash)
SITE_URL="http://localhost:3000"

# Optional: lock the whole public website behind one shared password (private preview). Leave empty for a public site.
SITE_PASSWORD=""

# First administrator, created by `npm run db:seed` if no admin exists yet.
# Use a strong password (12+ characters). Change it after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="LabSouq Admin"

# Where uploaded images are stored on disk (served at /media/...). Replace with S3/R2 in production.
UPLOAD_DIR="./uploads"

# ---- Cloud file storage (required on Vercel; optional on a private server) ----
# Any S3-compatible service: Cloudflare R2, AWS S3, DigitalOcean Spaces, MinIO.
# Leave S3_BUCKET empty to store files on the server disk (UPLOAD_DIR).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account-id>.r2.cloudflarestorage.com  (empty for AWS S3)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ---- docker-compose only ----
POSTGRES_PASSWORD=""
DOMAIN=""                 # e.g. labsouq.om — DNS must point to the server for HTTPS

# ======================== Omantel Facility Hub ========================
# Microsoft Entra ID single sign-on (production). Redirect URI: $SITE_URL/api/facility/auth/entra/callback
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
ENTRA_ALLOWED_DOMAINS=""         # e.g. omantel.om (comma separated). Empty = any account of the tenant.
FAC_BOOTSTRAP_ADMIN_EMAIL=""     # first Facility Operations admin, created by `npm run db:seed`

# Development sign-in with e-mail + password (sample accounts). Always off in production unless set to "true".
FAC_DEV_LOGIN=""
FAC_DEV_PASSWORD=""              # password of the development sample accounts (default FacilityHub-Dev-2026)
FAC_SAMPLE_DATA=""               # "false" = do not seed sample users/teams/SLA/requests (never seeded in production)

# E-mail: "log" (default, queued only) or "graph" (Microsoft Graph sendMail, application permission Mail.Send)
EMAIL_TRANSPORT="log"
GRAPH_SENDER=""                  # mailbox that sends, e.g. facility-hub@omantel.om
GRAPH_TENANT_ID=""               # optional, defaults to ENTRA_TENANT_ID
GRAPH_CLIENT_ID=""               # optional, defaults to ENTRA_CLIENT_ID
GRAPH_CLIENT_SECRET=""           # optional, defaults to ENTRA_CLIENT_SECRET

# Background jobs: GET /api/facility/jobs with "Authorization: Bearer <secret>" every ~5 minutes
FAC_CRON_SECRET=""

# Optional: replace the homepage hero video
FAC_HERO_VIDEO_URL=""
