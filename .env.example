# PostgreSQL connection string
DATABASE_URL="postgresql://labsouq:labsouq_dev@localhost:5432/labsouq?schema=public"

# Public address of the website (no trailing slash)
SITE_URL="http://localhost:3000"

# First administrator, created by `npm run db:seed` if no admin exists yet.
# Use a strong password (12+ characters). Change it after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="LabSouq Admin"

# Where uploaded images are stored on disk (served at /media/...). Replace with S3/R2 in production.
UPLOAD_DIR="./uploads"

# ---- Cloud file storage (required on Vercel; optional on a private server) ----
# Any S3-compatible service: Cloudflare R2, AWS S3, DigitalOcean Spaces, MinIO.
# Leave S3_BUCKET empty to store files on the server disk (UPLOAD_DIR).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account-id>.r2.cloudflarestorage.com  (empty for AWS S3)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ---- docker-compose only ----
POSTGRES_PASSWORD=""
DOMAIN=""                 # e.g. labsouq.om — DNS must point to the server for HTTPS
