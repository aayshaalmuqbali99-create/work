{
  "name": "omantel-cdp-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Omantel | CDP Programme Evaluation 2026 \u2014 results platform",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "node --import tsx --test tests/cdp/import.test.ts",
    "test:e2e": "node tests/cdp/e2e.cjs",
    "fixture": "python3 scripts/make_cdp_fixture.py tests/cdp/fixtures",
    "postinstall": "prisma generate",
    "build:html": "node scripts/build-html.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "fflate": "0.8.2",
    "lucide-react": "0.544.0",
    "motion": "12.23.12",
    "next": "15.5.29",
    "next-intl": "4.14.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.10",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.29",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
