// LabSouq database schema.
// Phase 3 scope: administration of the equipment showcase (users, sessions, categories, devices,
// images, inventory ledger, audit log). Marketplace entities (quotations, orders, messaging…) are
// added in later phases without changing these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // full access, manages users
  EDITOR // edits devices, categories, stock and prices
}

enum DeviceStatus {
  REVIEW // imported but not yet verified by the owner (not public)
  DRAFT // being prepared (not public)
  PUBLISHED // visible on the website
  ARCHIVED // hidden, kept for history
}

enum DeviceCondition {
  UNVERIFIED
  NEW
  USED
}

enum ModelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RequestType {
  DONATION // educational institution asks for a donation
  PURCHASE // buyer asks to purchase
}

enum RequestStatus {
  NEW
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum InventoryTxType {
  IMPORT
  ADJUSTMENT
  CORRECTION
}

model User {
  id           String                 @id @default(cuid())
  email        String                 @unique
  name         String
  passwordHash String
  role         Role                   @default(EDITOR)
  active       Boolean                @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
  inventoryTxs InventoryTransaction[]
  siteVersions SiteVersion[]
}

/// Server-side session. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String   @id @default(cuid())
  key       String   @unique
  nameEn    String
  nameAr    String
  descEn    String   @default("")
  descAr    String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices   Device[]

  @@index([sortOrder])
}

model Device {
  id                String                 @id @default(cuid())
  slug              String                 @unique
  status            DeviceStatus           @default(DRAFT)
  categoryId        String?
  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Key of the illustrative 3D device-type model (see src/components/viewer3d/archetypes.ts); null = no 3D.
  archetype         String?
  brand             String?
  model             String?
  nameEn            String
  nameAr            String                 @default("")
  descEn            String                 @default("")
  descAr            String                 @default("")
  usesEn            String[]
  usesAr            String[]
  benefitsEn        String[]
  benefitsAr        String[]
  condition         DeviceCondition        @default(UNVERIFIED)
  /// Current stock. Every change is recorded in InventoryTransaction.
  quantity          Int                    @default(0)
  /// Estimated market price of a comparable NEW unit (OMR). Never a selling price.
  marketPriceOMR    Decimal?               @db.Decimal(12, 3)
  /// Workbook item numbers this device came from (empty for devices added manually).
  sourceItemNos     Int[]
  /// Stable import key, e.g. "inventory-v1:26+82". Makes re-import idempotent.
  sourceKey         String?                @unique
  /// Original workbook description, kept for reference.
  sourceDescription String?
  sortOrder         Int                    @default(0)
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  images            DeviceImage[]
  inventory         InventoryTransaction[]
  models3d          Device3DModel[]

  @@index([status, categoryId])
  @@index([deletedAt])
}

model DeviceImage {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  url         String
  width       Int
  height      Int
  altEn       String   @default("")
  altAr       String   @default("")
  /// Workbook "Photo N" number when the image came from the workbook.
  sourcePhoto Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([deviceId, sortOrder])
}

/// A real 3D model (GLB) of the actual device. Several versions per device; at most one PUBLISHED.
model Device3DModel {
  id            String      @id @default(cuid())
  deviceId      String
  device        Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  version       Int
  status        ModelStatus @default(DRAFT)
  /// Set when an editor confirms the model represents this actual device. Required to publish.
  verified      Boolean     @default(false)
  fileUrl       String
  fileName      String
  fileSize      Int
  triangleCount Int
  /// Names of the nodes that can be configured as parts.
  nodeNames     String[]
  /// Part configuration: [{ id, node, en, ar, fnEn, fnAr, parent, explode: [x,y,z] | null }]
  parts         Json        @default("[]")
  createdById   String?
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([deviceId, version])
  @@index([deviceId, status])
}

model InventoryTransaction {
  id            String          @id @default(cuid())
  deviceId      String
  device        Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type          InventoryTxType
  delta         Int
  quantityAfter Int
  reason        String?
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([deviceId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. device.update, device.publish, auth.login
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Website content & appearance (brand, colours, homepage, footer) as a validated JSON document.
/// Exactly one DRAFT (working copy) and at most one PUBLISHED; older versions are ARCHIVED for restore.
model SiteVersion {
  id          String        @id @default(cuid())
  status      ContentStatus @default(DRAFT)
  data        Json
  note        String?
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

/// Fixed-window rate limiting shared by every server instance (login attempts etc.).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Donation or purchase request sent from the public "Request" page.
model AssetRequest {
  id           String        @id @default(cuid())
  type         RequestType
  status       RequestStatus @default(NEW)
  name         String
  organization String
  email        String
  phone        String
  city         String        @default("")
  /// [{ slug, name, quantity }]
  items        Json
  message      String        @default("")
  adminNote    String        @default("")
  ip           String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

// ============================================================================================
// Omantel Facility Hub — facility maintenance & cleaning requests (separate from the assets
// platform above: own users, sessions, roles and audit trail). Everything an operator might
// need to change (locations, categories, teams, routing, SLA, e-mail templates, maps) lives in
// these tables and is edited in the Facility Operations dashboard, never in code.
// ============================================================================================

enum FacRole {
  EMPLOYEE // submits and tracks own requests
  CONTRACTOR // sees and updates only requests assigned to their team
  AGENT // Facility Operations: manages every request
  ADMIN // Facility Operations administrator: also manages configuration and users
}

enum FacService {
  MAINTENANCE
  CLEANING
}

enum FacPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum FacStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
  REJECTED
}

enum FacTeamKind {
  INTERNAL
  CONTRACTOR
}

enum FacMapStatus {
  DRAFT
  PUBLISHED
}

enum FacEmailStatus {
  PENDING
  SENT
  FAILED
}

/// Location records are CONFIRMED (verified against the building) or PROVISIONAL (proposed until the official map is confirmed).
enum FacVerification {
  CONFIRMED
  PROVISIONAL
}

enum FacAttachmentKind {
  REPORT // photo added by the employee
  COMPLETION // photo added by Facility Operations / contractor when work is done
}

model FacUser {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  phone        String       @default("")
  department   String       @default("")
  role         FacRole      @default(EMPLOYEE)
  /// Local development sign-in only. Production users sign in with Microsoft Entra ID (no password stored).
  passwordHash String?
  /// Microsoft Entra ID object id (set on first SSO sign-in).
  entraOid     String?      @unique
  /// Contractors are limited to requests assigned to this team.
  teamId       String?
  team         FacTeam?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  locale       String       @default("ar")
  active       Boolean      @default(true)
  isSample     Boolean      @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     FacSession[]
  requests     FacRequest[] @relation("RequestEmployee")
}

model FacSession {
  id        String   @id // sha256(token)
  userId    String
  user      FacUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---- Location hierarchy: Building → Wing → Level (floor) → Zone/Area (nestable) → specific location fields ----

model FacBuilding {
  id        String       @id @default(cuid())
  code      String       @unique
  nameEn    String
  nameAr    String
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  wings     FacWing[]
  floors    FacFloor[]
  requests  FacRequest[]
}

model FacWing {
  id           String          @id @default(cuid())
  buildingId   String
  building     FacBuilding     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  code         String
  nameEn       String
  nameAr       String
  sortOrder    Int             @default(0)
  active       Boolean         @default(true)
  verification FacVerification @default(CONFIRMED)
  archivedAt   DateTime?
  floorLinks   FacFloorWing[]
  areas        FacArea[]
  locations    FacLocation[]
  requests     FacRequest[]
  maps         FacFloorMap[]

  @@unique([buildingId, code])
}

/// Which wings exist on which floor (many-to-many). A floor without links has no wing step.
model FacFloorWing {
  id           String          @id @default(cuid())
  floorId      String
  floor        FacFloor        @relation(fields: [floorId], references: [id], onDelete: Cascade)
  wingId       String
  wing         FacWing         @relation(fields: [wingId], references: [id], onDelete: Cascade)
  verification FacVerification @default(CONFIRMED)
  sortOrder    Int             @default(0)
  active       Boolean         @default(true)

  @@unique([floorId, wingId])
}

/// Reusable library of area types (Office, Meeting Room, Parking Area…). Areas reference it by key.
model FacAreaCategory {
  id            String    @id @default(cuid())
  /// Stable identifier used by areas and by problem rules (FacIssue.areaKinds).
  key           String    @unique
  nameEn        String
  nameAr        String
  icon          String    @default("map-pin")
  /// Location detail fields suggested when an area of this type is created.
  defaultFields String[]
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  archivedAt    DateTime?
  areas         FacArea[]
}

model FacFloor {
  id           String          @id @default(cuid())
  buildingId   String
  building     FacBuilding     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  code         String // e.g. B1, G, M, 1
  nameEn       String
  nameAr       String
  /// Vertical order: negative for basements.
  level        Int             @default(0)
  sortOrder    Int             @default(0)
  active       Boolean         @default(true)
  verification FacVerification @default(CONFIRMED)
  archivedAt   DateTime?
  wingLinks    FacFloorWing[]
  locations    FacLocation[]
  areas        FacArea[]
  maps         FacFloorMap[]
  requests     FacRequest[]

  @@unique([buildingId, code])
}

model FacArea {
  id           String          @id @default(cuid())
  floorId      String
  floor        FacFloor        @relation(fields: [floorId], references: [id], onDelete: Cascade)
  /// Optional parent (zone → area → sub-area).
  parentId     String?
  parent       FacArea?        @relation("AreaTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     FacArea[]       @relation("AreaTree")
  /// Area category key (FacAreaCategory.key). Drives which problems are offered.
  kind         String
  category     FacAreaCategory @relation(fields: [kind], references: [key], onUpdate: Cascade, onDelete: Restrict)
  /// Null = shared by every wing of the floor (or the floor has no wings).
  wingId       String?
  wing         FacWing?        @relation(fields: [wingId], references: [id], onDelete: SetNull)
  nameEn       String
  nameAr       String
  descEn       String          @default("")
  descAr       String          @default("")
  /// "Other / not listed": the employee describes the location in free text.
  isOther      Boolean         @default(false)
  /// Extra location fields asked for this area: office, room, meetingRoom, parkingSpace, column, elevator, entrance, landmark.
  fields       String[]
  /// Shown when the facility scope is limited (e.g. clinic and pharmacy: non-clinical only).
  scopeNoteEn  String          @default("")
  scopeNoteAr  String          @default("")
  /// Free metadata (room numbers, column ranges…) — never shown as fact unless entered by an administrator.
  meta         Json            @default("{}")
  /// Random token printed in the location QR code (reveals nothing about the location).
  qrToken      String          @unique @default(cuid())
  sortOrder    Int             @default(0)
  active       Boolean         @default(true)
  verification FacVerification @default(CONFIRMED)
  archivedAt   DateTime?
  locations    FacLocation[]
  markers      FacMapMarker[]
  requests     FacRequest[]

  @@index([floorId, sortOrder])
}

/// A specific, administrator-defined location: room, office, meeting room, parking section, elevator, entrance, landmark…
/// Floor-wide items (elevators, entrances, landmarks) have no area.
model FacLocation {
  id           String          @id @default(cuid())
  floorId      String
  floor        FacFloor        @relation(fields: [floorId], references: [id], onDelete: Cascade)
  wingId       String?
  wing         FacWing?        @relation(fields: [wingId], references: [id], onDelete: SetNull)
  areaId       String?
  area         FacArea?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// ROOM, OFFICE, MEETING_ROOM, PARKING_SECTION, ELEVATOR, ENTRANCE, LANDMARK, COLUMN
  kind         String
  /// Number or short identifier shown on site (e.g. "12", "P-A", "Lift 3").
  code         String          @default("")
  nameEn       String          @default("")
  nameAr       String          @default("")
  verification FacVerification @default(CONFIRMED)
  qrToken      String          @unique @default(cuid())
  sortOrder    Int             @default(0)
  active       Boolean         @default(true)
  archivedAt   DateTime?
  requests     FacRequest[]
  markers      FacMapMarker[]

  @@index([floorId, kind])
  @@index([areaId])
}

// ---- Service catalogue ----

model FacCategory {
  id        String           @id @default(cuid())
  service   FacService
  key       String           @unique
  nameEn    String
  nameAr    String
  descEn    String           @default("")
  descAr    String           @default("")
  icon      String           @default("wrench")
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  issues    FacIssue[]
  requests  FacRequest[]
  rules     FacRoutingRule[]

  @@index([service, sortOrder])
}

/// Subcategory: the concrete problem an employee picks.
model FacIssue {
  id              String       @id @default(cuid())
  categoryId      String
  category        FacCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameEn          String
  nameAr          String
  /// Area kinds where this issue is offered. Empty = every area. Areas marked "Other" show every issue.
  areaKinds       String[]
  /// Floor codes where this issue is offered. Empty = every floor.
  floorCodes      String[]
  defaultPriority FacPriority  @default(MEDIUM)
  /// Potentially dangerous: shows the safety warning before submission.
  safetyRisk      Boolean      @default(false)
  sortOrder       Int          @default(0)
  active          Boolean      @default(true)
  requests        FacRequest[]

  @@index([categoryId, sortOrder])
}

// ---- Teams, contractors and routing ----

model FacTeam {
  id             String           @id @default(cuid())
  nameEn         String
  nameAr         String
  kind           FacTeamKind      @default(INTERNAL)
  /// GENERAL, HVAC, ELECTRICAL, PLUMBING, CLEANING, CIVIL, ELEVATOR, PEST, PARKING…
  specialty      String
  email          String           @default("")
  /// Contractors can receive requests only after their scope has been confirmed by an administrator.
  scopeConfirmed Boolean          @default(false)
  notes          String           @default("")
  active         Boolean          @default(true)
  isSample       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  members        FacUser[]
  requests       FacRequest[]
  rules          FacRoutingRule[]
}

/// First matching active rule (lowest sortOrder) suggests / auto-assigns the team.
model FacRoutingRule {
  id         String       @id @default(cuid())
  service    FacService?
  categoryId String?
  category   FacCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  floorCode  String?
  areaKind   String?
  teamId     String
  team       FacTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Assign automatically on submission (otherwise only suggested to the operator).
  autoAssign Boolean      @default(false)
  sortOrder  Int          @default(0)
  active     Boolean      @default(true)
}

// ---- SLA ----

model FacSlaPolicy {
  id                String      @id @default(cuid())
  priority          FacPriority @unique
  /// Minutes to first response / to resolution. Null = no target configured.
  responseMinutes   Int?
  resolutionMinutes Int?
  /// Count only business hours (else 24/7).
  businessHoursOnly Boolean     @default(true)
  /// Development sample values, not approved contractual targets.
  isSample          Boolean     @default(false)
  updatedAt         DateTime    @updatedAt
}

/// Singleton (id = 1): business hours, escalation and notification settings.
model FacSettings {
  id                 Int      @id @default(1)
  timezone           String   @default("Asia/Muscat")
  workStart          String   @default("07:30")
  workEnd            String   @default("15:30")
  /// 0 = Sunday … 6 = Saturday
  workDays           Int[]    @default([0, 1, 2, 3, 4])
  /// Days after resolution during which the employee may reopen.
  reopenDays         Int      @default(7)
  /// Escalation e-mail recipients (comma separated). Empty = Facility Operations administrators.
  escalationEmails   String   @default("")
  /// Verified emergency contact text shown in the safety warning. Empty until provided by Facility Operations.
  emergencyContactEn String   @default("")
  emergencyContactAr String   @default("")
  /// Data upgrades applied by the seed (each runs once, so later administrator edits are never overwritten).
  seedVersion        Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model FacHoliday {
  id     String   @id @default(cuid())
  date   DateTime @unique @db.Date
  nameEn String
  nameAr String
}

/// Per-year sequence for reference numbers FAC-YYYY-000001.
model FacCounter {
  year  Int @id
  value Int
}

// ---- Requests ----

model FacRequest {
  id                String            @id @default(cuid())
  reference         String            @unique
  employeeId        String
  employee          FacUser           @relation("RequestEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  /// Contact details captured at submission (the employee may correct them per request).
  employeeName      String
  employeeEmail     String
  contactPhone      String            @default("")
  department        String            @default("")
  service           FacService
  categoryId        String?
  category          FacCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  issueId           String?
  issue             FacIssue?         @relation(fields: [issueId], references: [id], onDelete: SetNull)
  /// Free text when the employee chose "Other".
  issueOther        String            @default("")
  buildingId        String?
  building          FacBuilding?      @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floorId           String?
  floor             FacFloor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  wingId            String?
  wing              FacWing?          @relation(fields: [wingId], references: [id], onDelete: SetNull)
  areaId            String?
  area              FacArea?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  locationId        String?
  location          FacLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Snapshot of the location as text (kept even if the configuration changes later).
  locationLabelEn   String            @default("")
  locationLabelAr   String            @default("")
  /// { room, meetingRoom, parkingSpace, column, elevator, landmark, other }
  locationDetail    Json              @default("{}")
  description       String
  priority          FacPriority       @default(MEDIUM)
  safetyFlag        Boolean           @default(false)
  status            FacStatus         @default(SUBMITTED)
  teamId            String?
  team              FacTeam?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  responseDueAt     DateTime?
  resolutionDueAt   DateTime?
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  escalationLevel   Int               @default(0)
  overdueNotifiedAt DateTime?
  rating            Int?
  feedback          String            @default("")
  reopenCount       Int               @default(0)
  isSample          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  events            FacRequestEvent[]
  attachments       FacAttachment[]
  tokens            FacActionToken[]

  @@index([employeeId, createdAt])
  @@index([status, createdAt])
  @@index([teamId, status])
  @@index([floorId])
  @@index([wingId])
  @@index([areaId])
}

model FacRequestEvent {
  id        String     @id @default(cuid())
  requestId String
  request   FacRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// STATUS, COMMENT, ASSIGN, PRIORITY, ESCALATE, FEEDBACK, PHOTO
  type      String
  status    FacStatus?
  actorId   String?
  actorName String
  /// EMPLOYEE, CONTRACTOR, AGENT, ADMIN, SYSTEM
  actorRole String
  comment   String     @default("")
  /// Internal notes are never shown to the employee.
  internal  Boolean    @default(false)
  data      Json?
  createdAt DateTime   @default(now())

  @@index([requestId, createdAt])
}

model FacAttachment {
  id           String            @id @default(cuid())
  requestId    String
  request      FacRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Storage key under facility/… — served only through the authorised attachment route.
  storageKey   String
  width        Int
  height       Int
  kind         FacAttachmentKind @default(REPORT)
  uploadedById String?
  createdAt    DateTime          @default(now())

  @@index([requestId])
}

/// Single-use links in e-mails ("Yes, it's fixed" / "Still not fixed"). Only a hash is stored.
model FacActionToken {
  id        String     @id // sha256(token)
  requestId String
  request   FacRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  purpose   String // CONFIRM | REOPEN
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
}

// ---- Notifications ----

model FacEmailTemplate {
  id        String   @id @default(cuid())
  /// SUBMITTED, ASSIGNED, IN_PROGRESS, INFO_REQUIRED, RESOLVED, REOPENED, CLOSED, OVERDUE, ESCALATED
  key       String   @unique
  subjectEn String
  subjectAr String
  bodyEn    String
  bodyAr    String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Outbox: e-mails are queued in the same transaction as the change and delivered asynchronously.
model FacEmailOutbox {
  id            String         @id @default(cuid())
  to            String
  templateKey   String
  subject       String
  html          String
  text          String
  status        FacEmailStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  requestId     String?
  nextAttemptAt DateTime       @default(now())
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  @@index([status, nextAttemptAt])
}

// ---- Building maps ----

model FacFloorMap {
  id          String         @id @default(cuid())
  floorId     String
  floor       FacFloor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  /// Optional: a plan covering only one wing of the floor.
  wingId      String?
  wing        FacWing?       @relation(fields: [wingId], references: [id], onDelete: SetNull)
  title       String         @default("")
  /// Storage key under facmaps/… (raster image or validated SVG), served through the authorised map route.
  storageKey  String
  contentType String
  width       Int
  height      Int
  status      FacMapStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  markers     FacMapMarker[]

  @@index([floorId, status])
}

model FacMapMarker {
  id         String       @id @default(cuid())
  mapId      String
  map        FacFloorMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  areaId     String?
  area       FacArea?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  locationId String?
  location   FacLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// POINT or ZONE
  kind       String       @default("POINT")
  labelEn    String       @default("")
  labelAr    String       @default("")
  /// Position as a fraction of the map size (0…1), independent of the image resolution.
  x          Float
  y          Float
  /// ZONE outline: [[x,y], …] as fractions (0…1).
  points     Json?
  color      String       @default("#2D13EA")
}

model FacAudit {
  id        String   @id @default(cuid())
  userId    String?
  userName  String   @default("")
  action    String
  entity    String
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
